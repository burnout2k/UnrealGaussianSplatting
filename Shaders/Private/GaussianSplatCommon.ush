#ifndef GAUSSIAN_SPLAT_COMMON_USH
#define GAUSSIAN_SPLAT_COMMON_USH

float3x3 MakeFloat3x3FromRows(float3 Row0, float3 Row1, float3 Row2)
{
    return float3x3(
        Row0.x, Row0.y, Row0.z,
        Row1.x, Row1.y, Row1.z,
        Row2.x, Row2.y, Row2.z);
}

void LoadCovariance3D(
    StructuredBuffer<float4> Covariance0Buffer,
    StructuredBuffer<float4> Covariance1Buffer,
    uint InstanceID,
    float ScaleFactor,
    out float3 Cov3D0,
    out float3 Cov3D1)
{
    float4 Cov0 = Covariance0Buffer[InstanceID];
    float4 Cov1 = Covariance1Buffer[InstanceID];
    float ScaleFactor2 = ScaleFactor * ScaleFactor;

    Cov3D0 = float3(Cov0.x, Cov0.y, Cov0.z) * ScaleFactor2;
    Cov3D1 = float3(Cov0.w, Cov1.x, Cov1.y) * ScaleFactor2;
}

float3 CalcConic(float3 Cov2D)
{
    float det = Cov2D.x * Cov2D.z - Cov2D.y * Cov2D.y;
    return float3(Cov2D.z, -Cov2D.y, Cov2D.x) * rcp(max(det, 1e-8));
}

float3 CalcCovariance2DEx(
    float3 WorldPos,
    float3 Cov3D0,
    float3 Cov3D1,
    float4x4 LocalToWorldMatrix,
    float4x4 ViewMatrix,
    float4x4 ProjectionMatrix,
    float2 ViewSize,
    out float2 OutDepthGradientPx)
{
    float3x3 V = MakeFloat3x3FromRows(
        float3(Cov3D0.x, Cov3D0.y, Cov3D0.z),
        float3(Cov3D0.y, Cov3D1.x, Cov3D1.y),
        float3(Cov3D0.z, Cov3D1.y, Cov3D1.z));

    // Keep the Jacobian in the same row-vector convention used by the rest of
    // this shader (`mul(float4(Pos, 1), Matrix)`). Porting the original 3DGS
    // W/J/T formula directly led to a view-dependent ellipse orientation error
    // because UE/HLSL matrix conventions do not match the CUDA/GLM code path.
    float4x4 ViewProjectionMatrix = mul(ViewMatrix, ProjectionMatrix);
    float4 Clip = mul(float4(WorldPos, 1.0), ViewProjectionMatrix);
    float SafeW = abs(Clip.w) >= 1e-4 ? Clip.w : (Clip.w >= 0.0 ? 1e-4 : -1e-4);
    float InvW = rcp(SafeW);
    float InvW2 = InvW * InvW;

    float3 ClipGradX = float3(ViewProjectionMatrix[0][0], ViewProjectionMatrix[1][0], ViewProjectionMatrix[2][0]);
    float3 ClipGradY = float3(ViewProjectionMatrix[0][1], ViewProjectionMatrix[1][1], ViewProjectionMatrix[2][1]);
    float3 ClipGradW = float3(ViewProjectionMatrix[0][3], ViewProjectionMatrix[1][3], ViewProjectionMatrix[2][3]);

    // Analytic Jacobian of pixel coordinates with respect to world position.
    // This matches the numerically validated version but avoids the extra
    // projection work per splat.
    float3 JacobianRow0 =
        0.5 * ViewSize.x *
        (ClipGradX * SafeW - Clip.x * ClipGradW) * InvW2;
    float3 JacobianRow1 =
        -0.5 * ViewSize.y *
        (ClipGradY * SafeW - Clip.y * ClipGradW) * InvW2;

    // Covariance is stored in asset-local UE space. When the component rotates
    // or scales, the Gaussian shape must follow the same LocalToWorld linear
    // transform as the center position.
    float3 LocalToWorldRow0 = float3(LocalToWorldMatrix[0][0], LocalToWorldMatrix[0][1], LocalToWorldMatrix[0][2]);
    float3 LocalToWorldRow1 = float3(LocalToWorldMatrix[1][0], LocalToWorldMatrix[1][1], LocalToWorldMatrix[1][2]);
    float3 LocalToWorldRow2 = float3(LocalToWorldMatrix[2][0], LocalToWorldMatrix[2][1], LocalToWorldMatrix[2][2]);

    float3 LocalJacobianRow0 = float3(
        dot(JacobianRow0, LocalToWorldRow0),
        dot(JacobianRow0, LocalToWorldRow1),
        dot(JacobianRow0, LocalToWorldRow2));
    float3 LocalJacobianRow1 = float3(
        dot(JacobianRow1, LocalToWorldRow0),
        dot(JacobianRow1, LocalToWorldRow1),
        dot(JacobianRow1, LocalToWorldRow2));

    float3 CovRow0 = mul(LocalJacobianRow0, V);
    float3 CovRow1 = mul(LocalJacobianRow1, V);

    float CovXX = dot(CovRow0, LocalJacobianRow0) + 0.3;
    float CovXY = dot(CovRow0, LocalJacobianRow1);
    float CovYY = dot(CovRow1, LocalJacobianRow1) + 0.3;
    float3 Cov2D = float3(CovXX, CovXY, CovYY);

    // A Gaussian is a volume, so its depth is not constant across the screen
    // footprint. Testing the whole splat against its center depth makes
    // occlusion all-or-nothing, which shows up as background splats bleeding
    // over the silhouette of nearer geometry.
    //
    // For a Gaussian the expected depth conditioned on a screen offset is
    // LINEAR in that offset: E[dz | dp] = Cov(z, xy) * inverse(Cov2D) * dp.
    // Emitting that gradient lets the vertex shader give each quad corner its
    // own depth and the rasterizer interpolate between them for free.
    float3 ClipGradZ = float3(ViewProjectionMatrix[0][2], ViewProjectionMatrix[1][2], ViewProjectionMatrix[2][2]);
    float3 JacobianRow2 = (ClipGradZ * SafeW - Clip.z * ClipGradW) * InvW2;
    float3 LocalJacobianRow2 = float3(
        dot(JacobianRow2, LocalToWorldRow0),
        dot(JacobianRow2, LocalToWorldRow1),
        dot(JacobianRow2, LocalToWorldRow2));
    float3 CovRow2 = mul(LocalJacobianRow2, V);
    float CovXZ = dot(CovRow2, LocalJacobianRow0);
    float CovYZ = dot(CovRow2, LocalJacobianRow1);

    float3 Conic = CalcConic(Cov2D);
    OutDepthGradientPx = float2(
        CovXZ * Conic.x + CovYZ * Conic.y,
        CovXZ * Conic.y + CovYZ * Conic.z);

    return Cov2D;
}

// Original signature, for callers that do not need the depth gradient.
float3 CalcCovariance2D(
    float3 WorldPos,
    float3 Cov3D0,
    float3 Cov3D1,
    float4x4 LocalToWorldMatrix,
    float4x4 ViewMatrix,
    float4x4 ProjectionMatrix,
    float2 ViewSize)
{
    float2 UnusedGradient;
    return CalcCovariance2DEx(
        WorldPos, Cov3D0, Cov3D1, LocalToWorldMatrix,
        ViewMatrix, ProjectionMatrix, ViewSize, UnusedGradient);
}

float CalcPowerFromConic(float3 Conic, float2 Delta)
{
    return -0.5 * (Conic.x * Delta.x * Delta.x + Conic.z * Delta.y * Delta.y) + Conic.y * Delta.x * Delta.y;
}

void BuildEllipseAxes(float3 Cov2D, out float2 Axis0, out float2 Axis1)
{
    float Diag1 = Cov2D.x;
    float Diag2 = Cov2D.z;
    float OffDiag = Cov2D.y;
    float Mid = 0.5 * (Diag1 + Diag2);
    float Radius = length(float2((Diag1 - Diag2) * 0.5, OffDiag));
    float Lambda1 = max(Mid + Radius, 0.1);
    float Lambda2 = max(Mid - Radius, 0.1);

    float2 MajorDir;
    if (abs(OffDiag) > 1e-6 || abs(Lambda1 - Diag1) > 1e-6)
    {
        MajorDir = normalize(float2(OffDiag, Lambda1 - Diag1));
    }
    else
    {
        MajorDir = (Diag1 >= Diag2) ? float2(1.0, 0.0) : float2(0.0, 1.0);
    }

    float MaxSize = 4096.0;
    // Return the axes explicitly instead of packing them into a float2x2.
    // That keeps cull/raster usage identical and avoids row/column ambiguity.
    Axis0 = min(sqrt(2.0 * Lambda1), MaxSize) * MajorDir;
    Axis1 = min(sqrt(2.0 * Lambda2), MaxSize) * float2(-MajorDir.y, MajorDir.x);
}

#endif
