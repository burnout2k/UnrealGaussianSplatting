#include "/Engine/Public/Platform.ush"
#include "GaussianSplatCommon.ush"
#include "GaussianSplatCellLookup.ush"


uint SortKeyShift;
uint SortKeyMode;
RWBuffer<uint> SplatOrderBufferUAV;
RWBuffer<uint> SplatKeyBufferUAV;
RWBuffer<uint> SplatIndirectArgsUAV;

uint NumElements;
uint PaddedNumElements;
uint Stride;
uint SortK;
uint SortJ;
uint PassType;
float4 ViewWorldOrigin;
float4 ViewForward;
float2 ViewRectMin;
float2 ViewSize;
float PointSize;
float OpacityScale;
float MinSplatOpacity;
float MaxSplatDistance;
float MinScreenVariance;
float4x4 ViewMatrix;
float4x4 ProjectionMatrix;
float4x4 ViewProjectionMatrix;
float4x4 LocalToWorldMatrix;

#if OCC_BOX
// The hidden-splat cull's box path (r.GaussianSplat.OccTestPath 1): the visible branch also stores the splat's
// full-quad tile box at its dispatch index, for GaussianSplatOcclusion.usf's test. IsSplatVisible leaves the screen
// centre and axes here.
#include "GaussianSplatOccBox.ush"
RWBuffer<uint> OccBoxUAV;
uint OccTileShift;
float OccBoxPad;
static float2 GOccCenterPx;
static float2 GOccAxis0;
static float2 GOccAxis1;
#endif

// 0: the depth's float bits, top SortKeyBits kept (SortKeyShift = 32 - bits). 1 (r.GaussianSplat.SortKeyMode): 16
// bits over 8 cm .. 5.24 km, the clamped depth's low 4 exponent bits and top 12 mantissa bits = 4,096 steps per
// doubling. Its top key is 0xFFFE, so a 16-bit mask never makes it tie with the sort's 0xFFFFFFFF padding.
uint EncodeDepthKey(float Depth)
{
    if (SortKeyMode == 0)
    {
        return asuint(max(Depth, 0.0)) >> SortKeyShift;
    }
    const float KeyMinDepth = 8.0;                   // 2^3 cm
    const float KeyMaxDepth = asfloat(0x48FFF7FFu);  // 524,224 cm, one key step under 2^19 cm
    return (asuint(clamp(Depth, KeyMinDepth, KeyMaxDepth)) - asuint(KeyMinDepth)) >> 11;
}

float2 ProjectToPixel(float3 WorldPos, out float SafeClipW)
{
    float4 Clip = mul(float4(WorldPos, 1.0), ViewProjectionMatrix);
    SafeClipW = max(abs(Clip.w), 1e-4);

    float2 Ndc = Clip.xy / SafeClipW;
    return float2(
        ViewRectMin.x + (Ndc.x * 0.5 + 0.5) * ViewSize.x,
        ViewRectMin.y + (0.5 - Ndc.y * 0.5) * ViewSize.y);
}

bool IsSplatVisible(FSplatRef Splat, out float Depth)
{
    // Fix 5 Step 3 (plan D7): per-asset values come from the batch table, so ONE cull
    // dispatch can cover every district in the view. The plan's option (b) kept this
    // shader untouched and dispatched per batch instead, but OccBoxUAV below is indexed
    // by the dispatch index, so per-batch dispatches would collide there unless an
    // index offset were threaded through anyway -- which is a change to this shader too.
    // Reading the table is the smaller diff now that the raster and the occlusion
    // recompute already do it.
    const FGaussianSplatBatch Batch = SplatBatches[Splat.Batch];
    float3 CenterWS = mul(float4(DecodeSplatPosition(Splat.Index, Splat.Cell), 1.0), Batch.LocalToWorld).xyz;
    Depth = dot(CenterWS - ViewWorldOrigin.xyz, ViewForward.xyz);
    if (Depth <= 0.0)
    {
        return false;
    }

    // Bound the work for street-level views: without this the far side of the
    // capture is rasterised at full density even when it covers a few pixels.
    if (MaxSplatDistance > 0.0 && Depth > MaxSplatDistance)
    {
        return false;
    }

    // A splat this faint contributes only haze wherever it lands, and millions
    // of them stack into the milky veil that dense captures show. Rejecting it
    // here skips its whole rasterisation, not just its faint pixels.
    if (MinSplatOpacity > 0.0 &&
        saturate(DecodeSplatColor(Splat.Index, Batch.ColorEncoding).w * Batch.OpacityScale) < MinSplatOpacity)
    {
        return false;
    }

    float SafeClipW = 0.0;
    float2 CenterPx = ProjectToPixel(CenterWS, SafeClipW);
    if (SafeClipW <= 1e-4)
    {
        return false;
    }

    float3 Cov3D0;
    float3 Cov3D1;
    DecodeSplatCovariance(Splat.Index, Batch.PointSize * 0.35, Cov3D0, Cov3D1);

    float3 Cov2D = CalcCovariance2D(
        CenterWS,
        Cov3D0,
        Cov3D1,
        Batch.LocalToWorld,
        ViewMatrix,
        ProjectionMatrix,
        ViewSize);

    // Screen-space variance floor. CalcCovariance2D already adds the reference
    // 3DGS low-pass of 0.3; this is an additional floor on top. At 1.0 the minimum
    // quad is ~5.7x5.7 px for every splat at any distance, which defeats the free
    // LOD perspective would otherwise give and makes distant splats as expensive as
    // near ones. 0.0 leaves just the reference low-pass (~3.1x3.1 px) but lets far
    // surfaces thin out and show holes.
    Cov2D.x = max(Cov2D.x, MinScreenVariance);
    Cov2D.z = max(Cov2D.z, MinScreenVariance);

    float Det = Cov2D.x * Cov2D.z - Cov2D.y * Cov2D.y;
    if (Det <= 1e-6)
    {
        return false;
    }

    float2 Axis0;
    float2 Axis1;
    BuildEllipseAxes(Cov2D, Axis0, Axis1);
#if OCC_BOX
    GOccCenterPx = CenterPx;
    GOccAxis0 = Axis0;
    GOccAxis1 = Axis1;
#endif
    float2 BasisExtent = abs(Axis0) + abs(Axis1);
    float2 MinPx = CenterPx - BasisExtent;
    float2 MaxPx = CenterPx + BasisExtent;
    float2 ViewMin = ViewRectMin;
    float2 ViewMax = ViewRectMin + ViewSize;

    return !(MaxPx.x < ViewMin.x || MaxPx.y < ViewMin.y || MinPx.x > ViewMax.x || MinPx.y > ViewMax.y);
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
    uint Index = DTid.x;
    if (Index >= PaddedNumElements)
    {
        return;
    }

    if (PassType == 0)
    {
        if (Index == 0)
        {
            SplatIndirectArgsUAV[0] = 4;
            SplatIndirectArgsUAV[2] = 0;
            SplatIndirectArgsUAV[3] = 0;
        }

        if (Index < NumElements)
        {
            FSplatRef Splat = ResolveSplat(Index, Stride);
            float Depth = 0.0;
            bool bVisible = IsSplatVisible(Splat, Depth);
            if (bVisible)
            {
                uint VisibleIndex = 0;
                InterlockedAdd(SplatIndirectArgsUAV[1], 1, VisibleIndex);
                SplatOrderBufferUAV[VisibleIndex] = Index;
                SplatKeyBufferUAV[VisibleIndex] = EncodeDepthKey(Depth);
#if OCC_BOX
                OccBoxUAV[Index] = PackOccTileBox(GOccCenterPx, GOccAxis0, GOccAxis1, ViewRectMin, ViewSize, OccTileShift, OccBoxPad);
#endif
            }
        }
        return;
    }

    uint Partner = Index ^ SortJ;
    if (Partner <= Index || Partner >= PaddedNumElements)
    {
        return;
    }

    uint KeyA = SplatKeyBufferUAV[Index];
    uint KeyB = SplatKeyBufferUAV[Partner];
    uint OrderA = SplatOrderBufferUAV[Index];
    uint OrderB = SplatOrderBufferUAV[Partner];

    bool bAscending = (Index & SortK) == 0;
    bool bShouldSwap = bAscending ? (KeyA > KeyB) : (KeyA < KeyB);
    if (bShouldSwap)
    {
        SplatKeyBufferUAV[Index] = KeyB;
        SplatKeyBufferUAV[Partner] = KeyA;
        SplatOrderBufferUAV[Index] = OrderB;
        SplatOrderBufferUAV[Partner] = OrderA;
    }
}
