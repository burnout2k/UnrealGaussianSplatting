#include "/Engine/Public/Platform.ush"
#include "GaussianSplatCommon.ush"
#include "GaussianSplatCellLookup.ush"

StructuredBuffer<float4> SplatPositionBuffer;
StructuredBuffer<float4> SplatCovariance0Buffer;
StructuredBuffer<float4> SplatCovariance1Buffer;
StructuredBuffer<float4> SplatColorBuffer;

uint SortKeyShift;
RWBuffer<uint> SplatOrderBufferUAV;
RWBuffer<uint> SplatKeyBufferUAV;
RWBuffer<uint> SplatIndirectArgsUAV;

uint NumElements;
uint PaddedNumElements;
uint Stride;
uint SortK;
uint SortJ;
uint PassType;
float4 ViewWorldOrigin;
float4 ViewForward;
float2 ViewRectMin;
float2 ViewSize;
float PointSize;
float OpacityScale;
float MinSplatOpacity;
float MaxSplatDistance;
float MinScreenVariance;
float4x4 ViewMatrix;
float4x4 ProjectionMatrix;
float4x4 ViewProjectionMatrix;
float4x4 LocalToWorldMatrix;

uint EncodeDepthKey(float Depth)
{
    return asuint(max(Depth, 0.0));
}

float2 ProjectToPixel(float3 WorldPos, out float SafeClipW)
{
    float4 Clip = mul(float4(WorldPos, 1.0), ViewProjectionMatrix);
    SafeClipW = max(abs(Clip.w), 1e-4);

    float2 Ndc = Clip.xy / SafeClipW;
    return float2(
        ViewRectMin.x + (Ndc.x * 0.5 + 0.5) * ViewSize.x,
        ViewRectMin.y + (0.5 - Ndc.y * 0.5) * ViewSize.y);
}

bool IsSplatVisible(uint AssetIndex, out float Depth)
{
    float3 CenterWS = mul(float4(SplatPositionBuffer[AssetIndex].xyz, 1.0), LocalToWorldMatrix).xyz;
    Depth = dot(CenterWS - ViewWorldOrigin.xyz, ViewForward.xyz);
    if (Depth <= 0.0)
    {
        return false;
    }

    // Bound the work for street-level views: without this the far side of the
    // capture is rasterised at full density even when it covers a few pixels.
    if (MaxSplatDistance > 0.0 && Depth > MaxSplatDistance)
    {
        return false;
    }

    // A splat this faint contributes only haze wherever it lands, and millions
    // of them stack into the milky veil that dense captures show. Rejecting it
    // here skips its whole rasterisation, not just its faint pixels.
    if (MinSplatOpacity > 0.0 &&
        saturate(SplatColorBuffer[AssetIndex].w * OpacityScale) < MinSplatOpacity)
    {
        return false;
    }

    float SafeClipW = 0.0;
    float2 CenterPx = ProjectToPixel(CenterWS, SafeClipW);
    if (SafeClipW <= 1e-4)
    {
        return false;
    }

    float3 Cov3D0;
    float3 Cov3D1;
    LoadCovariance3D(SplatCovariance0Buffer, SplatCovariance1Buffer, AssetIndex, PointSize * 0.35, Cov3D0, Cov3D1);

    float3 Cov2D = CalcCovariance2D(
        CenterWS,
        Cov3D0,
        Cov3D1,
        LocalToWorldMatrix,
        ViewMatrix,
        ProjectionMatrix,
        ViewSize);

    // Screen-space variance floor. CalcCovariance2D already adds the reference
    // 3DGS low-pass of 0.3; this is an additional floor on top. At 1.0 the minimum
    // quad is ~5.7x5.7 px for every splat at any distance, which defeats the free
    // LOD perspective would otherwise give and makes distant splats as expensive as
    // near ones. 0.0 leaves just the reference low-pass (~3.1x3.1 px) but lets far
    // surfaces thin out and show holes.
    Cov2D.x = max(Cov2D.x, MinScreenVariance);
    Cov2D.z = max(Cov2D.z, MinScreenVariance);

    float Det = Cov2D.x * Cov2D.z - Cov2D.y * Cov2D.y;
    if (Det <= 1e-6)
    {
        return false;
    }

    float2 Axis0;
    float2 Axis1;
    BuildEllipseAxes(Cov2D, Axis0, Axis1);
    float2 BasisExtent = abs(Axis0) + abs(Axis1);
    float2 MinPx = CenterPx - BasisExtent;
    float2 MaxPx = CenterPx + BasisExtent;
    float2 ViewMin = ViewRectMin;
    float2 ViewMax = ViewRectMin + ViewSize;

    return !(MaxPx.x < ViewMin.x || MaxPx.y < ViewMin.y || MinPx.x > ViewMax.x || MinPx.y > ViewMax.y);
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
    uint Index = DTid.x;
    if (Index >= PaddedNumElements)
    {
        return;
    }

    if (PassType == 0)
    {
        if (Index == 0)
        {
            SplatIndirectArgsUAV[0] = 4;
            SplatIndirectArgsUAV[2] = 0;
            SplatIndirectArgsUAV[3] = 0;
        }

        if (Index < NumElements)
        {
            uint AssetIndex = ResolveSplatSourceIndex(Index, Stride);
            float Depth = 0.0;
            bool bVisible = IsSplatVisible(AssetIndex, Depth);
            if (bVisible)
            {
                uint VisibleIndex = 0;
                InterlockedAdd(SplatIndirectArgsUAV[1], 1, VisibleIndex);
                SplatOrderBufferUAV[VisibleIndex] = Index;
                SplatKeyBufferUAV[VisibleIndex] = EncodeDepthKey(Depth) >> SortKeyShift;
            }
        }
        return;
    }

    uint Partner = Index ^ SortJ;
    if (Partner <= Index || Partner >= PaddedNumElements)
    {
        return;
    }

    uint KeyA = SplatKeyBufferUAV[Index];
    uint KeyB = SplatKeyBufferUAV[Partner];
    uint OrderA = SplatOrderBufferUAV[Index];
    uint OrderB = SplatOrderBufferUAV[Partner];

    bool bAscending = (Index & SortK) == 0;
    bool bShouldSwap = bAscending ? (KeyA > KeyB) : (KeyA < KeyB);
    if (bShouldSwap)
    {
        SplatKeyBufferUAV[Index] = KeyB;
        SplatKeyBufferUAV[Partner] = KeyA;
        SplatOrderBufferUAV[Index] = OrderB;
        SplatOrderBufferUAV[Partner] = OrderA;
    }
}
