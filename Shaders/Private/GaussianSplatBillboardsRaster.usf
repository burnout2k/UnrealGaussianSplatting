#include "/Engine/Public/Platform.ush"
#include "GaussianSplatCommon.ush"
#include "GaussianSplatDepthTest.ush"
#include "GaussianSplatCellLookup.ush"

Buffer<uint> SplatOrderBuffer;
// One index per splat into a palette of distinct 45-float coefficient sets.
StructuredBuffer<uint> SplatSHIndexBuffer;
// Fix 5 Step 3 (review M5): one palette PER ASSET, bound as an array and chosen by
// the batch's slot. NOT one concatenated buffer: FRHIBufferDesc::Size is a uint32, so
// a single buffer caps at 4 GiB = 23.86M degree-3 entries, and concatenating would
// apply that cap to the SUM across districts. The switch below keeps the index static,
// so this needs no descriptor indexing and no bindless.
// EIGHT NAMED BUFFERS, not StructuredBuffer<float>[8]: an HLSL array of structured
// buffers does not survive this compiler ("subscripted value is not an array"), and
// SHADER_PARAMETER_SRV_ARRAY has no precedent in the engine's own renderer.
StructuredBuffer<float> SplatSHPalette0;
StructuredBuffer<float> SplatSHPalette1;
StructuredBuffer<float> SplatSHPalette2;
StructuredBuffer<float> SplatSHPalette3;
StructuredBuffer<float> SplatSHPalette4;
StructuredBuffer<float> SplatSHPalette5;
StructuredBuffer<float> SplatSHPalette6;
StructuredBuffer<float> SplatSHPalette7;

float2 ViewRectMin;
float2 ViewSize;
float4 ViewWorldOrigin;
float PointSize;
float OpacityScale;
uint Stride;
uint PerPixelDepth;
uint HasSH;
float MinScreenVariance;
float AlphaCutoff;
float4x4 ViewMatrix;
float4x4 LocalToWorldMatrix;
float4x4 ProjectionMatrix;
float4x4 ViewProjectionMatrix;
float4 WorldToLocalRow0;
float4 WorldToLocalRow1;
float4 WorldToLocalRow2;

struct VSOutput
{
    float4 Position : SV_POSITION;
    float2 QuadPos : TEXCOORD0;
    nointerpolation float4 Color : COLOR0;
};

static const float SH_C1 = 0.4886025;
static const float SH_C2[5] = { 1.0925484, -1.0925484, 0.3153916, -1.0925484, 0.5462742 };
static const float SH_C3[7] = { -0.5900436, 2.8906114, -0.4570458, 0.3731763, -0.4570458, 1.4453057, -0.5900436 };

float3 LoadSHCoeff(uint Slot, uint SHBase, uint CoeffIndex)
{
    const uint Offset = SHBase + CoeffIndex * 3;
    #define GS_FETCH(N) case N: return float3(SplatSHPalette##N[Offset + 0], \
                                              SplatSHPalette##N[Offset + 1], \
                                              SplatSHPalette##N[Offset + 2])
    switch (Slot)
    {
        GS_FETCH(0); GS_FETCH(1); GS_FETCH(2); GS_FETCH(3);
        GS_FETCH(4); GS_FETCH(5); GS_FETCH(6); GS_FETCH(7);
    }
    #undef GS_FETCH
    return float3(0.0, 0.0, 0.0);
}

float3 WorldDirToLocal(FGaussianSplatBatch Batch, float3 WorldDir)
{
    return float3(
        dot(Batch.WorldToLocalRow0.xyz, WorldDir),
        dot(Batch.WorldToLocalRow1.xyz, WorldDir),
        dot(Batch.WorldToLocalRow2.xyz, WorldDir));
}

float3 UELocalDirToColmapLocal(float3 UELocalDir)
{
    // Import converts COLMAP basis to UE basis as UE = (Z, X, -Y).
    // SH coefficients remain stored in the original COLMAP basis, so convert
    // the local view direction back before evaluating SH.
    return float3(
        UELocalDir.y,
        -UELocalDir.z,
        UELocalDir.x);
}

float3 EvaluateSH(float3 BaseColor, uint InstanceID, float3 ViewDirWS, FGaussianSplatBatch Batch)
{
    float3 Dir = -normalize(UELocalDirToColmapLocal(WorldDirToLocal(Batch, ViewDirWS)));
    float X = Dir.x;
    float Y = Dir.y;
    float Z = Dir.z;

    float3 Result = BaseColor;
    if (Batch.HasSH == 0)
    {
        // Degree-0 capture: the SH buffer holds one dummy element, not per-splat
        // data. Reading it would sample garbage.
        return max(Result, 0.0);
    }

    const uint SHBase = SplatSHIndexBuffer[InstanceID] * 45;
    Result += SH_C1 * (-LoadSHCoeff(Batch.PaletteSlot, SHBase, 0) * Y + LoadSHCoeff(Batch.PaletteSlot, SHBase, 1) * Z - LoadSHCoeff(Batch.PaletteSlot, SHBase, 2) * X);

    float XX = X * X;
    float YY = Y * Y;
    float ZZ = Z * Z;
    float XY = X * Y;
    float YZ = Y * Z;
    float XZ = X * Z;

    Result +=
        (SH_C2[0] * XY) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 3) +
        (SH_C2[1] * YZ) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 4) +
        (SH_C2[2] * (2.0 * ZZ - XX - YY)) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 5) +
        (SH_C2[3] * XZ) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 6) +
        (SH_C2[4] * (XX - YY)) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 7);

    Result +=
        (SH_C3[0] * Y * (3.0 * XX - YY)) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 8) +
        (SH_C3[1] * XY * Z) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 9) +
        (SH_C3[2] * Y * (4.0 * ZZ - XX - YY)) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 10) +
        (SH_C3[3] * Z * (2.0 * ZZ - 3.0 * XX - 3.0 * YY)) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 11) +
        (SH_C3[4] * X * (4.0 * ZZ - XX - YY)) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 12) +
        (SH_C3[5] * Z * (XX - YY)) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 13) +
        (SH_C3[6] * X * (XX - 3.0 * YY)) * LoadSHCoeff(Batch.PaletteSlot, SHBase, 14);

    return max(Result, 0.0);
}

float2 ProjectToPixel(float3 WorldPos, out float SafeClipW, out float DeviceZ)
{
    float4 Clip = mul(float4(WorldPos, 1.0), ViewProjectionMatrix);
    SafeClipW = max(abs(Clip.w), 1e-4);
    DeviceZ = Clip.z / SafeClipW;

    float2 Ndc = Clip.xy / SafeClipW;
    return float2(
        ViewRectMin.x + (Ndc.x * 0.5 + 0.5) * ViewSize.x,
        ViewRectMin.y + (0.5 - Ndc.y * 0.5) * ViewSize.y);
}

VSOutput MainVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID)
{
    VSOutput Output = (VSOutput)0;

    const FSplatRef Splat = ResolveSplat(SplatOrderBuffer[InstanceID], Stride);
    // Everything per asset comes from here, so one draw can span districts (D7).
    const FGaussianSplatBatch Batch = SplatBatches[Splat.Batch];
    InstanceID = Splat.Index;

    float3 CenterWS = mul(float4(DecodeSplatPosition(Splat.Index, Splat.Cell), 1.0), Batch.LocalToWorld).xyz;
    float SafeClipW = 0.0;
    float DeviceZ = 0.0;
    float2 CenterPx = ProjectToPixel(CenterWS, SafeClipW, DeviceZ);
    if (SafeClipW <= 1e-4)
    {
        Output.Position = asfloat(0x7fc00000);
        return Output;
    }

    float3 Cov3D0;
    float3 Cov3D1;
    DecodeSplatCovariance(Splat.Index, Batch.PointSize * 0.35, Cov3D0, Cov3D1);

    float2 DepthGradientPx;
    float3 Cov2D = CalcCovariance2DEx(
        CenterWS,
        Cov3D0,
        Cov3D1,
        Batch.LocalToWorld,
        ViewMatrix,
        ProjectionMatrix,
        ViewSize,
        DepthGradientPx);

    // Screen-space variance floor. CalcCovariance2D already adds the reference
    // 3DGS low-pass of 0.3; this is an additional floor on top. At 1.0 the minimum
    // quad is ~5.7x5.7 px for every splat at any distance, which defeats the free
    // LOD perspective would otherwise give and makes distant splats as expensive as
    // near ones. 0.0 leaves just the reference low-pass (~3.1x3.1 px) but lets far
    // surfaces thin out and show holes.
    Cov2D.x = max(Cov2D.x, MinScreenVariance);
    Cov2D.z = max(Cov2D.z, MinScreenVariance);

    float Det = Cov2D.x * Cov2D.z - Cov2D.y * Cov2D.y;
    if (Det <= 1e-6)
    {
        Output.Position = asfloat(0x7fc00000);
        return Output;
    }

    float2 Axis0;
    float2 Axis1;
    BuildEllipseAxes(Cov2D, Axis0, Axis1);
    float2 QuadPos = float2((VertexID == 1 || VertexID == 3) ? 1.0 : -1.0, (VertexID >= 2) ? 1.0 : -1.0) * 2.0;
    float2 DeltaPx = Axis0 * QuadPos.x + Axis1 * QuadPos.y;
    float2 PixelPos = CenterPx + DeltaPx;

    float2 BasisExtent = abs(Axis0) + abs(Axis1);
    float2 MinPx = CenterPx - BasisExtent;
    float2 MaxPx = CenterPx + BasisExtent;
    float2 ViewMin = ViewRectMin;
    float2 ViewMax = ViewRectMin + ViewSize;
    if (MaxPx.x < ViewMin.x || MaxPx.y < ViewMin.y || MinPx.x > ViewMax.x || MinPx.y > ViewMax.y)
    {
        Output.Position = asfloat(0x7fc00000);
        return Output;
    }

    float2 PixelPosInView = PixelPos - ViewRectMin;
    float2 Ndc = float2(
        2.0 * PixelPosInView.x / max(ViewSize.x, 1.0) - 1.0,
        1.0 - 2.0 * PixelPosInView.y / max(ViewSize.y, 1.0));
    // Give each quad corner the Gaussian's own depth at that offset instead of
    // reusing the center depth, so the rasterizer interpolates a depth that
    // follows the splat across its footprint. Without this the scene-depth test
    // is all-or-nothing per splat and background splats bleed over the
    // silhouette of nearer objects. Clamped because a splat seen nearly edge-on
    // has a steep gradient that could otherwise push a corner out of range.
    // The raster pass reads, but does not modify, Unreal's opaque scene depth.
    float CornerDeviceZ = DeviceZ;
    if (PerPixelDepth != 0)
    {
        CornerDeviceZ = clamp(DeviceZ + dot(DepthGradientPx, DeltaPx), 0.0, 1.0);
    }
    Output.Position = float4(Ndc, CornerDeviceZ, 1.0);
    Output.QuadPos = QuadPos;

    float3 ViewDirWS = normalize(ViewWorldOrigin.xyz - CenterWS);
    float4 BaseColor = DecodeSplatColor(InstanceID, Batch.ColorEncoding);
    Output.Color = float4(
        EvaluateSH(
            BaseColor.rgb,
            InstanceID,
            ViewDirWS,
            Batch),
        saturate(BaseColor.a * Batch.OpacityScale));
    return Output;
}

float4 MainPS(VSOutput Input) : SV_Target0
{
    ApplyGaussianSplatSceneDepthTest(Input.Position);

    float Weight = exp(-dot(Input.QuadPos, Input.QuadPos));
    float Alpha = saturate(Input.Color.a * Weight);
    if (Alpha < AlphaCutoff)
    {
        discard;
    }

    return float4(Input.Color.rgb * Alpha, Alpha);
}
